foreach(argument IN ITEMS version --version -v)
    execute_process(COMMAND "${BUDO}" "${argument}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "${argument} failed (${status}): ${error}")
    endif()
    if(DEFINED report AND NOT output STREQUAL report)
        message(FATAL_ERROR "${argument} did not match the output of 'budo version'")
    endif()
    set(report "${output}")
endforeach()

string(FIND "${report}" "budo ${BUDO_VERSION}\ncommit: " prefix)
if(NOT prefix EQUAL 0)
    message(FATAL_ERROR "Unexpected version banner:\n${report}")
endif()
if(NOT report MATCHES
        "\nRuntime engines:\n  JavaScript: [^\n]+\n  Lua: [^\n]+\n  Wasmtime: [^\n]+\n\nDependencies \\(build-time\\):\n")
    message(FATAL_ERROR "Runtime engine versions are not grouped:\n${report}")
endif()
string(REGEX MATCHALL "\n[ ]*[Jj]ava[Ss]cript:" javascript_entries "${report}")
list(LENGTH javascript_entries javascript_count)
if(NOT javascript_count EQUAL 1)
    message(FATAL_ERROR "Expected one JavaScript version entry:\n${report}")
endif()
foreach(entry IN ITEMS "SQLite" "Skia" "Expat"
        "SDL2" "zlib" "OpenSSL" "stb_image" "miniaudio" "Ogg" "Opus" "opusfile"
        "llama[.]cpp" "ONNX Runtime" "C compiler" "C[+][+] compiler"
        "CMAKE_C_FLAGS" "CMAKE_CXX_FLAGS" "CMAKE_EXE_LINKER_FLAGS")
    if(NOT report MATCHES "\n  ${entry}: [^\n]+\n")
        message(FATAL_ERROR "Missing ${entry} in version report:\n${report}")
    endif()
endforeach()
string(FIND "${report}" "\n  Configuration: ${BUDO_CONFIG}\n" configuration)
if(configuration EQUAL -1)
    message(FATAL_ERROR "Incorrect build configuration:\n${report}")
endif()
foreach(feature IN ITEMS NEURAL LLAMACPP)
    if(BUDO_${feature})
        set(state ON)
    else()
        set(state OFF)
    endif()
    string(FIND "${report}" "\n  ENABLE_${feature}: ${state}\n" setting)
    if(setting EQUAL -1)
        message(FATAL_ERROR "Incorrect ENABLE_${feature} setting:\n${report}")
    endif()
endforeach()

if(BUDO_ANDROID)
    foreach(entry IN ITEMS
            "Android support bundle: ${BUDO_ANDROID_TAG}"
            "Android support bundle default SHA-256: ${BUDO_ANDROID_SHA}"
            "Android support bundle default URL: ${BUDO_ANDROID_BASE_URL}/budo-android-support-${BUDO_ANDROID_SHA}.tar.gz")
        string(FIND "${report}" "\n  ${entry}\n" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "Missing Android support bundle detail '${entry}':\n${report}")
        endif()
    endforeach()
elseif(report MATCHES "\n  Android support bundle")
    message(FATAL_ERROR "Android support bundle reported when packaging is disabled:\n${report}")
endif()
