                    },
                    {
                        "name": "readText",
                        "namespace": "sys.assets",
                        "signature": "(path: safe bundle-relative path) -> string|null"
                    }
                ],
                "lua": [
                    {
                        "name": "readText",
                        "namespace": "sys.files",
