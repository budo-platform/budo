                    },
                    {
                        "name": "readText",
                        "namespace": "sys.assets",
                        "signature": "(path: safe bundle-relative path) -> string|nil"
                    }
                ],
                "wasmtime": {
                    "name": "files_read_text",
                    "signature": "(path_ptr: i32, path_len: i32, out_ptr: i32, out_max_len: i32) -> i32 bytes written; -1 on failure"
                }
            }
        },
        {
