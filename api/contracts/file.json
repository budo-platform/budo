{
    "version": 1,
    "subsystem": "file",
    "error_convention": {
        "javascript": {
            "kind": "throw_programmer_error_return_falsy_transient",
            "details": "Wrong arity or type and unsafe virtual paths throw; missing roots, missing or denied entries, I/O failures, and picker launch contention return null or false, with sys.files.getError and sys.assets.getError sharing the wrapper error string."
        },
        "lua": {
            "kind": "throw_programmer_error_return_falsy_transient",
            "details": "luaL checks reject wrong arguments and unsafe paths; missing roots, missing or denied entries, and I/O failures return nil or false, with sys.files.getError and sys.assets.getError sharing the wrapper error string."
        },
        "wasmtime": {
            "kind": "documented_sentinel_on_failure",
            "details": "Host calls do not trap and expose no get-error import: list, reads, and size return -1 on failure while exists and is_directory return 0; successful output writes may be truncated to the guest buffer and return the bytes copied."
        }
    },
    "wrapper_header": "src/file/file_wrapper.h",
    "service_header": "src/file/file_service.h",
    "runtimes": {
        "javascript": {
            "source": "src/file/js_file_bindings.c",
            "registration_symbol": "js_file_init",
            "namespace": [
                "sys.files",
                "sys.assets"
            ],
            "platforms": [
                "desktop",
                "android",
                "web"
            ],
            "export_extractor": "quickjs_function_data"
        },
        "lua": {
            "source": "src/file/lua_file_bindings.c",
            "registration_symbol": "lua_file_init",
            "namespace": [
                "sys.files",
                "sys.assets"
            ],
            "platforms": [
                "desktop",
                "android",
                "web"
            ],
            "export_extractor": "lua_reg"
        },
        "wasmtime": {
            "source": "src/file/wasm_file_bindings.c",
            "registration_symbol": "wasm_file_register",
            "namespace": "env",
            "platforms": [
                "desktop"
            ],
            "export_extractor": "wasmtime_host"
        }
    },
    "unsupported_runtimes": {
        "browser_wasm": {
            "source": "src/web/web_main.c",
            "registration_symbol": "js_web_wasm_start",
            "platforms": [
                "web"
            ],
            "reason": "The browser-native WebAssembly env object registers no files_* imports.",
            "absent_export_prefixes": [
                "files_"
            ]
        }
    },
    "operations": [
        {
            "name": "list",
            "wrapper_symbol": "file_list",
            "signature": "(path?: string) -> file_entry[]|null",
            "exports": {
                "javascript": [
                    {
                        "name": "list",
                        "namespace": "sys.files",
                        "signature": "(path?: assets/|files/ virtual path) -> Array<{name,type,size?}>|null"
                    },
                    {
                        "name": "list",
                        "namespace": "sys.assets",
                        "signature": "(path?: safe bundle-relative path) -> Array<{name,type,size?}>|null"
                    }
                ],
                "lua": [
                    {
                        "name": "list",
                        "namespace": "sys.files",
                        "signature": "(path?: assets/|files/ virtual path) -> table[]|nil"
                    },
                    {
                        "name": "list",
                        "namespace": "sys.assets",
                        "signature": "(path?: safe bundle-relative path) -> table[]|nil"
                    }
                ],
                "wasmtime": {
                    "name": "files_list_json",
                    "signature": "(path_ptr: i32, path_len: i32, out_ptr: i32, out_max_len: i32) -> i32 JSON bytes written; -1 on failure"
                }
            }
        },
        {
            "name": "read_text",
            "wrapper_symbol": "file_read_text",
            "service_symbol": "file_service_read_text",
            "signature": "(path: string) -> string|null",
            "exports": {
                "javascript": [
                    {
