{
    "version": 1,
    "subsystem": "canvas",
    "error_convention": {
        "javascript": {
            "kind": "throws_on_invalid_arguments_or_operation_failure",
            "details": "QuickJS coercion accepts many numeric values, but invalid colors, stroke modes, filter arguments, buffers, or failed allocations can throw. Drawing without an active canvas is generally a no-op; getError returns and clears paint/filter errors."
        },
        "lua": {
            "kind": "throws_on_invalid_arguments_or_operation_failure",
            "details": "luaL argument checks raise Lua errors for invalid required values and failed allocations. Drawing without an active canvas is generally a no-op; getError returns and clears paint/filter errors."
        },
        "wasmtime": {
            "kind": "documented_sentinel_on_failure",
            "details": "Host imports do not trap. Missing canvas, paint, memory, or invalid handles make void imports no-ops; canvas_read_pixels returns 0, text measurement returns 0, and output pointers are written only when valid."
        },
        "browser_wasm": {
            "kind": "documented_sentinel_on_failure",
            "details": "Browser env imports do not trap. Missing canvas or paint makes drawing and state changes no-ops; drawText returns 0. The browser bridge exposes only a portable subset and performs no guest-memory pixel readback or text measurement."
        }
    },
    "wrapper_headers": [
        "src/graphics/skia_wrapper.h"
    ],
    "runtimes": {
        "javascript": {
            "source": "src/graphics/js_core_bindings.c",
            "export_sources": [
                "src/graphics/js_canvas_bindings.c"
            ],
            "registration_symbol": "js_runtime_create",
            "namespace": [
                "sys.canvas"
            ],
            "platforms": [
                "desktop",
                "android",
                "web"
            ],
            "export_extractor": "quickjs_cfunc",
            "export_scopes": [
                "js_sys_canvas_funcs"
            ]
        },
        "lua": {
            "source": "src/graphics/lua_canvas_bindings.c",
            "export_sources": [
                "src/graphics/lua_transform_bindings.c"
            ],
            "registration_symbol": "lua_canvas_create",
            "namespace": [
                "sys.canvas"
            ],
            "platforms": [
                "desktop",
                "android",
                "web"
            ],
            "export_extractor": "lua_reg",
            "export_scopes": [
                "canvas_funcs"
            ]
        },
        "wasmtime": {
            "source": "src/graphics/wasm_canvas_bindings.c",
            "export_sources": [
                "src/graphics/wasm_transform_bindings.c"
            ],
            "registration_symbol": "wasm_canvas_create",
            "namespace": "env",
            "platforms": [
                "desktop"
            ],
            "export_extractor": "wasmtime_host",
            "export_prefixes": [
                "canvas_",
                "transform_"
            ]
        },
        "browser_wasm": {
            "source": "src/web/web_main.c",
            "registration_symbol": "js_web_wasm_start",
            "namespace": "env",
            "platforms": [
                "web"
            ],
            "export_extractor": "javascript_object_key",
            "export_prefixes": [
                "canvas_",
                "transform_"
            ]
        }
    },
    "state_ownership": {
        "javascript": "Each JSCanvasContext owns its default paint, path/SVG/font registries, timers, callback values, and QuickJS runtime. Callbacks recover that instance through QuickJS context/runtime opaque data; no mutable process-global canvas context is retained. The frame host lends the current canvas, input, and window pointers.",
        "lua": "Each LuaCanvasContext owns its default paint, path/SVG/font registries, callback reference, and Lua state. Callbacks recover that instance from the owning Lua state's private registry entry, keyed by an immutable file-scope identity token; no mutable process-global canvas context is retained. The frame host lends the current canvas, input, and window pointers.",
        "wasmtime": "Each WasmCanvasContext owns its default paint, path/SVG registries, Wasmtime engine/linker/store/module, and subsystem binding states. Every canvas host callback receives that instance through its linker environment; no mutable process-global canvas context is retained. The frame host lends the current canvas, input, and window pointers.",
        "browser_wasm": "The web host keeps one browser-WASM paint and fixed path registry in WebAppState and lends the current window canvas to bridge calls."
    },
    "platform_differences": {
        "web": {
            "source": "src/web/web_main.c",
            "details": [
                "Managed JavaScript and Lua use the same Skia-backed canvas binding tables as desktop and Android.",
                "Browser-native WebAssembly exposes 11 canvas/paint imports and five transform imports; it omits pixel readback, text measurement, oval/point/arc drawing, stroke cap/join, advanced filters, skew, reset, and clipping.",
                "Browser-native drawText bridges guest UTF-8 through temporary Emscripten memory, while Wasmtime reads directly from the guest memory export."
            ]
        },
        "android": {
            "source": "src/graphics/js_canvas_bindings.c",
            "details": [
                "Android has managed JavaScript and Lua canvas bindings but no Wasmtime or browser-native WebAssembly runtime."
            ]
        }
    },
