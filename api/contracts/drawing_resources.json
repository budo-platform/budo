{
    "version": 1,
    "subsystem": "drawing_resources",
    "error_convention": {
        "javascript": {
            "kind": "throws_on_invalid_arguments_or_operation_failure",
            "details": "Path calls ignore invalid handles, while failed path/SVG/font allocation or loading and invalid managed buffer arguments can throw or return -1 according to the binding. Runtime-owned handles are released when the canvas context is destroyed."
        },
        "lua": {
            "kind": "throws_on_invalid_arguments_or_operation_failure",
            "details": "luaL checks raise for invalid arguments and resource load failures. Invalid path/SVG handles generally become no-ops or zero dimensions; runtime-owned handles are released with the canvas context."
        },
        "wasmtime": {
            "kind": "documented_sentinel_on_failure",
            "details": "Host imports do not trap. Creation/loading returns -1 on capacity, memory, path, or decode failure; invalid handles make void calls no-ops and SVG dimensions return 0."
        },
        "browser_wasm": {
            "kind": "documented_sentinel_on_failure",
            "details": "The browser bridge exposes only path create, move, line, close, and draw. Creation returns -1 after the fixed registry is full or allocation fails; invalid handles are ignored."
        }
    },
    "wrapper_header": "src/graphics/skia_wrapper.h",
    "runtimes": {
        "javascript": {
            "source": "src/graphics/js_core_bindings.c",
            "export_sources": [
                "src/graphics/js_canvas_bindings.c"
            ],
            "registration_symbol": "js_runtime_create",
            "namespace": [
                "sys.path",
                "sys.svg",
                "sys.font"
            ],
            "platforms": [
                "desktop",
                "android",
                "web"
            ],
            "export_extractor": "quickjs_cfunc",
            "export_scopes": [
                "js_sys_path_funcs",
                "js_sys_svg_funcs",
                "js_sys_font_funcs"
            ]
        },
        "lua": {
            "source": "src/graphics/lua_canvas_bindings.c",
            "registration_symbol": "lua_canvas_create",
            "namespace": [
                "sys.path",
                "sys.svg",
                "sys.font"
            ],
            "platforms": [
                "desktop",
                "android",
                "web"
            ],
            "export_extractor": "lua_reg",
            "export_scopes": [
                "path_funcs",
                "svg_funcs",
                "font_funcs"
            ]
        },
        "wasmtime": {
            "source": "src/graphics/wasm_canvas_bindings.c",
            "registration_symbol": "wasm_canvas_create",
            "namespace": "env",
            "platforms": [
                "desktop"
            ],
            "export_extractor": "wasmtime_host",
            "export_prefixes": [
                "path_",
                "svg_"
            ]
        },
        "browser_wasm": {
            "source": "src/web/web_main.c",
            "registration_symbol": "js_web_wasm_start",
            "namespace": "env",
            "platforms": [
                "web"
            ],
            "export_extractor": "javascript_object_key",
            "export_prefixes": [
                "path_",
                "svg_"
            ]
        }
    },
    "state_ownership": {
        "javascript": "JSCanvasContext owns all path, SVG, and font handles and the copied font names; explicit SVG destroy clears a slot, while paths and fonts otherwise live until context destruction.",
        "lua": "LuaCanvasContext owns all path, SVG, and font handles and copied font names; explicit SVG destroy clears a slot, while paths and fonts otherwise live until context destruction.",
        "wasmtime": "WasmCanvasContext owns fixed-capacity path and SVG handle registries; there is no Wasmtime font-management import surface.",
        "browser_wasm": "WebAppState owns a fixed-capacity path registry for the active browser-WASM app and destroys it during web shutdown."
    },
    "platform_differences": {
        "web": {
            "source": "src/web/web_main.c",
            "details": [
                "Managed JavaScript and Lua expose the complete path, SVG, and font tables on web.",
                "Browser-native WebAssembly exposes only five path imports and has no SVG or font imports.",
                "Browser-native paths cannot be reset, curved, or extended with rectangle/circle helpers; Wasmtime exposes the complete path and SVG import sets but no font imports."
            ]
        }
    },
