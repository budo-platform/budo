{
  "version": 1,
  "subsystem": "audio",
  "error_convention": {
    "javascript": {
      "kind": "documented_sentinel_on_failure",
      "details": "Unavailable contexts and backend failures produce no-ops, false, 0.0, or -1 depending on the operation; loadBufferFromBuffer throws TypeError for a non-ArrayBuffer, and getError exposes the backend message. Most other missing or coercible arguments are accepted without throwing."
    },
    "lua": {
      "kind": "documented_sentinel_on_failure",
      "details": "luaL argument checks and setBufferData allocation failure raise Lua errors; unavailable contexts and backend failures otherwise produce no-ops, false, fallback gain 0.5, or -1, and getError exposes the backend message."
    },
    "wasmtime": {
      "kind": "documented_sentinel_on_failure",
      "details": "Host calls do not trap: mutating imports become no-ops when audio is unavailable and audio_create_oscillator returns -1. Wasmtime exposes neither getError nor buffer, playback-state, or master-gain query imports."
    }
  },
  "wrapper_header": "src/audio/audio_wrapper.h",
  "service_header": "src/audio/audio_service.h",
  "runtimes": {
    "javascript": {
      "source": "src/audio/js_audio_bindings.c",
      "registration_symbol": "js_audio_init",
      "namespace": "sys.audio",
      "platforms": [
        "desktop",
        "android",
        "web"
      ],
      "export_extractor": [
        "quickjs_function_data",
        "quickjs_int_property"
      ]
    },
    "lua": {
      "source": "src/audio/lua_audio_bindings.c",
      "registration_symbol": "lua_audio_init",
      "namespace": "sys.audio",
      "platforms": [
        "desktop",
        "android",
        "web"
      ],
      "export_extractor": [
        "lua_reg",
        "lua_integer_field"
      ]
    },
    "wasmtime": {
      "source": "src/audio/wasm_audio_bindings.c",
      "registration_symbol": "wasm_audio_register",
      "namespace": "env",
      "platforms": [
        "desktop"
      ],
      "export_extractor": "wasmtime_host"
    }
  },
  "unsupported_runtimes": {
    "browser_wasm": {
      "source": "src/web/web_main.c",
      "registration_symbol": "js_web_wasm_start",
      "platforms": [
        "web"
      ],
      "reason": "The browser-native WebAssembly env object registers no audio_* imports; browser audio is exposed only to the managed JavaScript and Lua runtimes.",
      "absent_export_prefixes": [
        "audio_"
      ]
    }
  },
  "platform_differences": {
    "android": {
      "source": "private/android/android/app/src/main/cpp/android_audio.c",
      "details": [
        "Binding state and AudioContext wrappers are instance-owned, while Android audio initialization, cached JNI method IDs, and the AudioTrack helper remain process-global platform state.",
        "AAudio streams are stored per AndroidAudioContext, but concurrent backend operation, especially through the shared AudioTrack fallback helper, is not guaranteed by binding isolation."
      ]
    },
    "web": {
      "source": "src/web/web_audio.c",
      "details": [
        "Managed JavaScript and Lua register sys.audio on web.",
        "Browser-native WebAssembly receives no env.audio_* imports.",
        "Each managed adapter owns its C binding state and asset root, but web_audio routes all wrappers through the single Module._hw_audio Web Audio graph; concurrent independent web backends are not supported."
      ]
    }
  },
  "constants": [
