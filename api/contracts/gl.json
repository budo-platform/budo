{
    "version": 1,
    "subsystem": "gl",
    "error_convention": {
        "javascript": {
            "kind": "throws_on_invalid_arguments_or_operation_failure",
            "details": "QuickJS validates object receivers, buffers, enum strings, dimensions, and required arguments, and throws TypeError, RangeError, or InternalError on invalid input or wrapper failure. getLastError returns the window GL error string without adding a Wasm-style copy ABI."
        },
        "lua": {
            "kind": "throws_on_invalid_arguments_or_operation_failure",
            "details": "luaL checks raise for invalid arguments; resource creation and most immediate GL failures raise Lua errors using the window GL error. Destruction functions are generally tolerant of missing context or stale ids."
        },
        "wasmtime": {
            "kind": "documented_sentinel_on_failure",
            "details": "Host imports do not trap. Resource creation and attribute lookup return -1 on missing context, invalid guest memory, or wrapper failure; upload and resize imports return 0 on failure; void imports become no-ops and retain the last error only inside WasmCanvasContext."
        },
        "browser_wasm": {
            "kind": "documented_sentinel_on_failure",
            "details": "Browser env imports do not throw into the guest. Creation returns -1 and buffer upload returns 0 on failure; void imports are no-ops without a window or valid temporary-memory range. Only eleven GL imports are exposed."
        }
    },
    "wrapper_header": "src/core/window.h",
    "runtimes": {
