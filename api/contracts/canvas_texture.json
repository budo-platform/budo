{
    "version": 1,
    "subsystem": "canvas_texture",
    "error_convention": {
        "javascript": {
            "kind": "throws_on_invalid_arguments_or_operation_failure",
            "details": "Creation and resize require positive dimensions and throw on invalid arguments or allocation failure. Methods throw TypeError for an invalid/destroyed receiver where checked; destroy is idempotent after clearing the object metadata."
        }
    },
    "wrapper_headers": [
        "src/core/window_canvas_texture.h",
        "src/graphics/skia_wrapper.h"
    ],
    "runtimes": {
        "javascript": {
            "source": "src/graphics/js_core_bindings.c",
            "export_sources": [
                "src/graphics/js_canvas_bindings.c"
            ],
            "registration_symbol": "js_runtime_create",
            "namespace": [
                "sys.graphics",
                "CanvasTexture",
                "CanvasTexture.canvas"
            ],
            "platforms": [
                "desktop",
                "android",
                "web"
            ],
            "export_extractor": "quickjs_cfunc",
            "export_scopes": [
                "js_sys_graphics_funcs",
                "js_canvas_texture_funcs",
                "js_canvas_texture_canvas_funcs"
            ]
        }
    },
    "unsupported_runtimes": {
        "lua": {
            "source": "src/graphics/lua_canvas_bindings.c",
            "registration_symbol": "lua_canvas_create",
            "platforms": [
                "desktop",
                "android",
                "web"
            ],
            "reason": "Lua registers no sys.graphics table and exposes no CanvasTexture object methods."
        },
        "wasmtime": {
            "source": "src/graphics/wasm_canvas_bindings.c",
            "registration_symbol": "wasm_canvas_create",
            "platforms": [
                "desktop"
            ],
            "reason": "Wasmtime registers no canvas_texture_* or graphics_* host imports."
        },
        "browser_wasm": {
            "source": "src/web/web_main.c",
            "registration_symbol": "js_web_wasm_start",
            "platforms": [
                "web"
            ],
            "reason": "The browser-native WebAssembly env object registers no CanvasTexture creation or object API.",
            "absent_export_prefixes": [
                "canvas_texture_",
                "graphics_"
            ]
        }
    },
    "state_ownership": {
        "javascript": "JSCanvasContext owns every created CanvasTexture and destroys any live entries during context teardown. Each object exposes copied id/size/GL metadata plus methods that resolve the id back through that owning context."
    },
    "platform_differences": {
        "web": {
            "source": "src/graphics/js_canvas_bindings.c",
            "details": [
                "Managed JavaScript exposes CanvasTexture on web through the Skia-WASM GL backend.",
                "Managed Lua and browser-native WebAssembly expose no equivalent surface.",
                "The public object has id, width, height, texture, target, and canvas data properties; callable registration coverage is tracked here separately from those constructed fields."
            ]
        }
    },
    "operations": [
